# Dependencies
node_modules/
*/node_modules/

# Environment Variables
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Build output
dist/
frontend/dist/
build/

# Uploads and databases (keep local runtime files out of git)
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/*.db*
!backend/data/.gitkeep
data/*.db*
!data/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System Files
.DS_Store
Thumbs.db
